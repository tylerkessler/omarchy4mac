#!/usr/bin/env bash
# JankyBorders — TK OS Sunset (tyler-os #1524)
# Reload: brew services restart borders
# Docs: https://github.com/FelixKratz/JankyBorders

options=(
  style=round                # round | square
  width=5.0
  hidpi=on
  active_color=0x00000000    # clear: the focused border is six Sunset stops, drawn by tyler-os dotfiles/hammerspoon/sunset_border.lua (#1524)
  inactive_color=0x802a2a44  # Sunset overlay at 50%
  background_color=0x00000000
  # Ignore invisible system alert windows (ghost borders on empty workspaces)
  blacklist="UserNotificationCenter"
)

borders "${options[@]}"
