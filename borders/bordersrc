#!/usr/bin/env bash
# JankyBorders — TKOS sunset (same stops as SketchyBar live_vibe.sh / tyler-os rail.py SUN)
# Reload: brew services restart borders
# Docs: https://github.com/FelixKratz/JankyBorders
# Palette: SUN = ["#ff8b4b", "#ff6392", "#d148f0", "#8b5cf6"]
# Gradient + glow cannot combine (JankyBorders #155); keep the gradient.

options=(
  style=round                # round | square
  width=5.0
  hidpi=on
  active_color="gradient(top_left=0xffff8b4b,bottom_right=0xff8b5cf6)"
  inactive_color=0xcc240f2e  # dusk plum, quieter than PLUM fill
  background_color=0x00000000
  # Ignore invisible system alert windows (ghost borders on empty workspaces)
  blacklist="UserNotificationCenter"
)

borders "${options[@]}"
