#!/usr/bin/env bash
# SketchyBar — TKOS Live, the TKOS sunset: dusk-plum islands, orange → pink → magenta → violet
# Reload: brew services restart sketchybar  (or: sketchybar --reload)

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/live_vibe.sh"

# ---------- Bar ----------
# Invisible strip. The rounded pills (brackets below) are the chrome.
# No full-width fill, no pink rectangle, no bar shadow.
sketchybar --bar \
  position=top \
  height=36 \
  y_offset=6 \
  margin=10 \
  blur_radius=0 \
  color=0x00000000 \
  border_color=0x00000000 \
  border_width=0 \
  corner_radius=0 \
  padding_left=8 \
  padding_right=8 \
  notch_width=200 \
  display=all \
  topmost=on \
  sticky=on \
  show_in_fullscreen=on \
  shadow=off

# ---------- Defaults ----------
default=(
  padding_left=4
  padding_right=4
  icon.font="Hack Nerd Font:Bold:14.0"
  label.font="Hack Nerd Font:Bold:13.0"
  icon.color="$FG"
  label.color="$FG"
  icon.padding_left=6
  icon.padding_right=6
  label.padding_left=4
  label.padding_right=6
  icon.shadow.drawing=on
  icon.shadow.distance=2
  icon.shadow.color="$GLOW"
  background.corner_radius=10
  background.height=28
)
sketchybar --default "${default[@]}"

# ---------- Custom events ----------
sketchybar --add event aerospace_workspace_change

# ---------- Logo: opens the Omarchy menu (v4 bar, leftmost) ----------
sketchybar --add item logo left \
           --set logo \
                 icon="󰣇" \
                 icon.color="$ACCENT" \
                 icon.padding_left=8 \
                 icon.padding_right=8 \
                 icon.shadow.drawing=on \
                 icon.shadow.distance=5 \
                 icon.shadow.color="$GLOW" \
                 label.drawing=off \
                 background.drawing=off \
                 click_script="/opt/homebrew/bin/hs -c 'omarchyMenu()'"

# ---------- Claudia: her face, status, menu and voice chat (tyler-os coach/claudia_bar.py, issue #913) ----------
# Left click = talk (then type), right click = her menu. The item, badge and popup are built by `claudia_bar.py setup`.
python3 "${TKOS_CLAUDIA_BAR:-$HOME/Scripts/tyler-os-live/coach/claudia_bar.py}" setup

# ---------- Computer-use banner: red while an agent drives the Mac, green with totals when hands come off (tyler cu) ----------
python3 "${TKOS_CU_BAR:-$HOME/Scripts/tyler-os-live/coach/cu_bar.py}" setup

# ---------- AeroSpace workspaces ----------
for sid in 1 2 3 4 5; do
  sketchybar --add item space."$sid" left \
             --subscribe space."$sid" aerospace_workspace_change space_change \
             --set space."$sid" \
                   icon="$sid" \
                   icon.color="$SOFT" \
                   label.drawing=off \
                   background.color="$ACCENT" \
                   background.corner_radius=8 \
                   background.height=22 \
                   background.drawing=off \
                   click_script="/opt/homebrew/bin/aerospace workspace $sid" \
                   script="$PLUGIN_DIR/aerospace.sh"
done

# Separator between workspaces and front_app
sketchybar --add item space_sep left \
           --set space_sep \
                 icon="│" \
                 icon.color="$PINK" \
                 icon.padding_left=8 \
                 icon.padding_right=8 \
                 icon.shadow.drawing=on \
                 icon.shadow.distance=3 \
                 icon.shadow.color="$GLOW_PINK" \
                 label.drawing=off \
                 background.drawing=off

# ---------- Front app (focused window) ----------
sketchybar --add item front_app left \
           --set front_app \
                 label.color="$ACCENT" \
                 icon.color="$ACCENT" \
                 icon.padding_right=4 \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# ---------- Spotify (now-playing marquee) ----------
# Event-driven, never polled: Spotify's own distributed notification (its userInfo arrives in $INFO) and
# SketchyBar's media_change. A 5 s poll here ran osascript into a hung Spotify and piled up 100+ stuck processes.
sketchybar --add event spotify_change "com.spotify.client.PlaybackStateChanged"
sketchybar --add item spotify left \
           --set spotify \
                 drawing=off \
                 icon="" \
                 icon.color="$GREEN" \
                 label.color="$FG" \
                 label.max_chars=32 \
                 scroll_texts=on \
                 label.scroll_duration=200 \
                 background.drawing=off \
                 script="$PLUGIN_DIR/spotify.sh" \
                 click_script="osascript -e 'tell application \"Spotify\" to playpause'" \
           --subscribe spotify spotify_change media_change

# Next-track button (shown/hidden together with the marquee by spotify.sh)
sketchybar --add item spotify_next left \
           --set spotify_next \
                 drawing=off \
                 icon="" \
                 icon.color="$FG" \
                 label.drawing=off \
                 background.drawing=off \
                 click_script="osascript -e 'tell application \"Spotify\" to next track'"

# Star (shown/hidden with the marquee by spotify.sh): ★ gold = in Your Library, ☆ = not yet; click to flip it.
# Needs a one-time `tyler spotify login` (tyler-os coach/spotify_library.py); until then it shows a dim ☆.
sketchybar --add item spotify_star left \
           --set spotify_star \
                 drawing=off \
                 icon="☆" \
                 icon.color="$COMMENT" \
                 label.drawing=off \
                 background.drawing=off \
                 click_script="$PLUGIN_DIR/spotify_star.sh"

# ---------- Center: indicators · clock · weather · updates · theme ----------
# Indicators show only while their state is on (v4 bar). Pinned to the
# external displays by clock.sh, like the clock: the notch eats the centre.
for ind in indicator_awake indicator_dnd; do
  sketchybar --add item "$ind" center \
             --set "$ind" \
                   drawing=off \
                   label.drawing=off \
                   background.drawing=off \
                   update_freq=10 \
                   script="$PLUGIN_DIR/indicators.sh"
done
sketchybar --subscribe indicator_awake system_woke display_change \
           --subscribe indicator_dnd display_change

sketchybar --add item clock center \
           --set clock \
                 update_freq=10 \
                 icon="" \
                 icon.color="$PINK" \
                 label.color="$FG" \
                 icon.shadow.drawing=on \
                 icon.shadow.distance=4 \
                 icon.shadow.color="$GLOW_PINK" \
                 script="$PLUGIN_DIR/clock.sh" \
                 click_script='open "x-apple.systempreferences:com.apple.Date-Time-Settings.extension"' \
           --subscribe clock display_change

sketchybar --add item weather center \
           --set weather \
                 drawing=off \
                 icon.drawing=off \
                 label.color="$FG" \
                 update_freq=1800 \
                 script="$PLUGIN_DIR/weather.sh" \
                 click_script='open https://wttr.in' \
           --subscribe weather system_woke display_change

# Update badge: outdated Homebrew packages, hidden at zero (v4 bar).
sketchybar --add item updates center \
           --set updates \
                 drawing=off \
                 update_freq=21600 \
                 script="$PLUGIN_DIR/updates.sh" \
                 click_script="open -na Ghostty --args -e $HOME/.local/bin/omarchy-tui sh -c 'brew update && brew upgrade'" \
           --subscribe updates system_woke display_change

# Stand-up / sit-down state, centre copy: shows on the external displays next to
# the centred theme name. Added straight after theme_name so it lands beside it.
# The right-cluster copy (standup) covers the built-in panel. One plugin drives
# both; it pins each copy to the right display set like clock.sh does.
sketchybar --add item standup_center center \
           --set standup_center \
                 drawing=off \
                 update_freq=20 \
                 icon.color="$FG" \
                 label.drawing=off \
                 background.drawing=off \
                 script="$PLUGIN_DIR/standup.sh"

# v4 bar order, left to right: agents · power. (Wi-Fi, Bluetooth, volume and theme hidden by choice.)
# Right items lay out right-to-left in add order, so battery goes first.
sketchybar --add item battery right \
           --set battery \
                 update_freq=2 \
                 icon.font="Hack Nerd Font:Bold:16.0" \
                 icon.padding_right=2 \
                 label.color="$FG" \
                 script="$PLUGIN_DIR/battery.sh" \
                 click_script="$PLUGIN_DIR/battery_click.sh" \
           --subscribe battery system_woke power_source_change

# Power flow, just left of the battery: watts + a dot travelling into the battery (charging) or out of it (on battery).
# battery.sh fills it; a click opens the same terminal as the battery.
sketchybar --add item power_flow right \
           --set power_flow \
                 drawing=off \
                 icon.font="Hack Nerd Font:Bold:12.0" \
                 icon.padding_left=8 \
                 icon.padding_right=2 \
                 icon.shadow.drawing=off \
                 label.font="Hack Nerd Font:Bold:13.0" \
                 label.padding_left=0 \
                 label.padding_right=0 \
                 padding_left=0 \
                 padding_right=0 \
                 click_script="$PLUGIN_DIR/battery_click.sh"

# Right-side clock + theme name — the leftmost pair of the right cluster, i.e.
# immediately in front of the battery. These are the built-in display's variant:
# clock.sh pins them to the notched laptop panel and pins the centered pair to
# the external displays, so both layouts are live at once on different screens.
#
# Right-side items are laid out right-to-left in the order they're added, so
# theme_name_right must be added BEFORE clock_right to end up on its right —
# preserving the same clock-then-theme reading order as the centered pair.
# Stand-up / sit-down state of the interval timer (~/.hermes/standup_timer.sh).
# Added straight after theme_name_right so it draws immediately to the LEFT of the
# theme name (right items lay out right-to-left in add order). Icon only: a chair
# while seated, a standing person while standing. Hidden when no timer runs.
sketchybar --add item standup right \
           --set standup \
                 drawing=off \
                 update_freq=20 \
                 icon.color="$FG" \
                 label.drawing=off \
                 background.drawing=off \
                 script="$PLUGIN_DIR/standup.sh"

sketchybar --add item clock_right right \
           --set clock_right \
                 drawing=off \
                 icon="󰥔" \
                 icon.color="$PINK" \
                 label.color="$FG" \
                 icon.shadow.drawing=on \
                 icon.shadow.distance=4 \
                 icon.shadow.color="$GLOW_PINK" \
                 click_script='open "x-apple.systempreferences:com.apple.Date-Time-Settings.extension"'


# Coding-agent usage: today's Claude Code spend, hidden at zero (v4 bar).
sketchybar --add item agents right \
           --set agents \
                 drawing=off \
                 update_freq=900 \
                 script="$PLUGIN_DIR/agents.sh" \
                 click_script="open -na Ghostty --args -e $HOME/.local/bin/omarchy-tui bunx ccusage daily"

# ---------- Islands: the ticker's sunset pills ----------
# Dusk-plum fill, a soft hairline in one sunset stop per island, left to right: orange, pink, magenta, violet.
# Light themes skip live_vibe.sh, so each colour falls back to the theme's own.
_PILL=(
  background.color="${PLUM:-$BG_PILL}"
  background.corner_radius=14
  background.height=28
  background.border_width=1
  background.shadow.drawing=on
  background.shadow.distance=3
  background.shadow.color=0x66000000
)
sketchybar --add bracket vibe_left space.1 space.2 space.3 space.4 space.5 space_sep front_app \
           --set vibe_left "${_PILL[@]}" background.border_color="${HAIR_1:-$OVERLAY}"

sketchybar --add bracket vibe_music spotify spotify_next spotify_star \
           --set vibe_music "${_PILL[@]}" background.border_color="${HAIR_2:-$OVERLAY}"

sketchybar --add bracket vibe_center clock weather standup_center \
           --set vibe_center "${_PILL[@]}" background.border_color="${HAIR_3:-$OVERLAY}"

sketchybar --add bracket vibe_right agents clock_right standup power_flow battery \
           --set vibe_right "${_PILL[@]}" background.border_color="${HAIR_4:-$OVERLAY}"

# ---------- Force first run ----------
sketchybar --update
sketchybar --trigger aerospace_workspace_change \
  FOCUSED_WORKSPACE="$(/usr/bin/perl -e 'alarm 1; exec @ARGV' /opt/homebrew/bin/aerospace list-workspaces --focused 2>/dev/null)"


# Prime front_app on startup with the currently focused app name
# 2 s limit: a pending Automation prompt or a busy System Events must not hang the whole config load.
FRONT_APP="$(/usr/bin/perl -e 'alarm 2; exec @ARGV' /usr/bin/osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null)"
NAME=front_app SENDER=front_app_switched INFO="$FRONT_APP" bash "$PLUGIN_DIR/front_app.sh"

# Prime Spotify marquee on startup
NAME=spotify bash "$PLUGIN_DIR/spotify.sh"

# Prime the stand-up / sit-down icons on startup (they have no event to subscribe to)
NAME=standup bash "$PLUGIN_DIR/standup.sh"
NAME=standup_center bash "$PLUGIN_DIR/standup.sh"
